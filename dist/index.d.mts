      /** 71.0 A* 搜索：优化器最优子计划搜索（旁路咨询口径） */
      astarSearch?: {
        enabled?: boolean;
      };
      /** 72.0 稀疏恢复：优化器质量归因的 Lasso+CV 稀疏 active 集（旁路分析） */
      sparseRecovery?: {
