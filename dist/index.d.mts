  readonly cause?: unknown;
  constructor(message: string, options?: TypedErrorOptions);
  /** 导出为注册表条目形态（与 ERROR_REGISTRY 单条同构） */
  toTaxonomyEntry(): ErrorTaxonomyEntry;
  /** 是否值得重试（immediate / backoff） */
  get retryable(): boolean;
