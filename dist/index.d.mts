  /** 每链延迟 d ≥ 1（缺省 1; 总延迟 = (m+1)·d） */
  readonly delayPerLink?: number;
  /** 逐链复制保真度 ∈ (0,1]（缺省 0.9） */
  readonly fidelity?: number;
  /** true: 链头换成隐藏外源 c（动作以 followProb **同步**跟随 c——观察歧义流） */
