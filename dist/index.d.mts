  readonly error?: string;
}
/** 一次全量检查的报告（注册序确定） */
interface InvariantReport {
  readonly ok: boolean;
  /** 已检查不变量总数 */
  readonly total: number;
  /** 通过数 */
  readonly passedCount: number;
  /** 违例清单（按注册序；带描述） */
  readonly violations: readonly InvariantViolation[];
}
/** 声明一条不变量（id 缺省取 description 本身，保证报告可读且稳定） */
declare function invariant<S>(description: string, check: (subject: S) => boolean, id?: string): InvariantSpec<S>;
/**
 * 不变量注册表：模块声明自己的健康规约，一次检查全部
 *
 * check：全量检查（谓词抛错按违例记账，不中断）；
 * assert：全量检查后若有违例抛 AggregateAppError（消息含全部违例描述）。
 */
declare class InvariantRegistry<S = any> {
  readonly kind: string;
  private readonly specsInOrder;
  private readonly byId;
  constructor(kind: string);
  /** 注册一条（id 重复抛——违例清单需要唯一归因） */
  register(spec: InvariantSpec<S>): this;
  /** 批量注册（注册序 = 数组序） */
  registerAll(specs: readonly InvariantSpec<S>[]): this;
  /** 已注册清单（注册序） */
  specs(): readonly InvariantSpec<S>[];
  /** 全量检查（不抛；谓词抛错按违例记账） */
  check(subject: S): InvariantReport;
  /** 全量检查 + 违例即抛 AggregateAppError（失败清单带描述） */
  assert(subject: S): InvariantReport;
}
/** 创建不变量注册表（kind = 被检对象的领域名） */
declare function createInvariantRegistry<S>(kind: string): InvariantRegistry<S>;
/** 一次性全量检查（无注册表时的轻量入口；specs 序 = 检查序 = 报告序） */
declare function checkInvariants<S>(subject: S, specs: readonly InvariantSpec<S>[]): InvariantReport;
/** 一次性全量检查 + 违例即抛（接受注册表或裸 specs 数组） */
declare function assertInvariants<S>(subject: S, target: InvariantRegistry<S> | readonly InvariantSpec<S>[]): InvariantReport;
