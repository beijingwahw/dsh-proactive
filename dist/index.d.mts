  /** 64.0：协调议题的相关均衡画像（未挂载返回 undefined） */
  coordinationProfile(actions: number[], utilities: number[][], options?: {
    steps?: number;
    seed?: number;
  }): {
    game: NormalGame;
    ce: LearnCEResult;
    check: CECheck;
  } | undefined;
  /**
   * 65.0：挂载动态定价（影子口径）。
