  nearest: ReadonlyArray<{
    modelId: string;
    score: number;
    distance: number;
    weight: number;
  }>;
  /** 全量候选排名（期望分降序 / 同分按 modelId 升序——确定性） */
  ranking: ReadonlyArray<{
