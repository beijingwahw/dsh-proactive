 * 一维半空间深度（Tukey 1975）: depth(x) = min(#{v ≤ x}, #{v ≥ x}) / n。
 *
 * 中位数处 ≈ 0.5（最深）、离开中心单调下降、出值域即 0——「离已见世界
 * 的中心多深」的非参数口径（无分布假设; 与 Mahalanobis 的椭圆假设互补）。
 */
declare function halfspaceDepth1D(reference: readonly number[], x: number): number;
