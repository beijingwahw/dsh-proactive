  stats?(): {
    patterns: number;
    profiles: number;
    feedback: number;
    strategies: number;
    /** 第二阶段：语义记忆条数 */
    semantic: number;
    /** 第二阶段：程序记忆条数 */
    procedural: number;
    pageSize: number;
    pageCount: number;
    walSize: number;
    schemaVersion: number;
    fts: boolean;
    vec: boolean;
  };
  checkpoint?(): void;
  vacuum?(): void;
  backup?(destPath: string): string;
  rawQuery?(sql: string, params?: Array<string | number | null>): Array<Record<string, unknown>>;
}
