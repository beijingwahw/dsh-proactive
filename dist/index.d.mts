  lensRange: {
    min: number;
    max: number;
  };
  intervalWidth: number;
  /** 每个区间的节点数直方图（中段 =2 是 y 滤镜下环的左右两链指纹） */
  intervalHistogram: number[];
  maxNodeSize: number;
  meanNodeSize: number;
  /** 至少落入一个节点的点比例（等宽覆盖下应为 1——诚实核对而非假设） */
  coverage: number;
  /** 覆盖口径（R5）：'uniform' = 等宽区间（缺省，向后兼容）；'balanced' = 分位数秩窗口 */
  coverKind?: 'uniform' | 'balanced';
