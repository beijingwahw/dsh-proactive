  rounds: number;
  batchSize: number;
  bufferSizeBefore: number;
  bufferSizeAfter: number;
  freshTransitions: 0;
}
/**
 * ④ 睡眠固化: 不加新环境数据，只重放历史经验的离线批量改进。
 *
 * 每轮: 优先采样批 → IS 加权逐样本更新 V(a) → 新 |TD| = |r − V̂(a)|
 * 回写优先级（消化过的经验自动降权）。策略价值用真值表测量
 * truth[greedyArm]——「未消化经验」缓冲区（数据与学习器当前认知相矛盾）
