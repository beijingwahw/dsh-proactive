      noveltySearch?: {
        enabled?: boolean;
        k?: number;
      };
      /** 92.0 自我对弈：策略进化对抗压力审计（可剥削度 + 联赛 exploiter 档案；影子计算） */
      selfPlay?: {
        enabled?: boolean;
        leagueRounds?: number;
        seed?: number;
      };
