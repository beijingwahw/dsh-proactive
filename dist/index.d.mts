      ccaAlignment?: {
        enabled?: boolean;
        lambda?: number;
      };
      /** 79.0 扩散映射：经验连续嵌入（与 69.0 Mapper 成对：骨架 + 连续坐标；旁路咨询） */
      diffusionManifold?: {
        enabled?: boolean;
        k?: number;
        dims?: number;
      };
      /** 80.0 流式概要：哨兵高频流缓冲（键频上界/滑窗计数/等概率样本/重元素；观测口径） */
      streamingSketch?: {
        enabled?: boolean;
