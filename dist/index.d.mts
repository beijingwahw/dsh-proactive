  /** 判定来源策略 */
  readonly policy: RetryPolicy;
  /** 判定用的错误码 */
  readonly code: string;
  /** 重试步骤（空 = 不重试）：attempt=2..maxAttempts，各带等待毫秒 */
  readonly steps: ReadonlyArray<{
    readonly attempt: number;
    readonly delayMs: number;
  }>;
