 * 逐槽漂移证书（验证锚点⑤）: 对单步演化 Q⁺ = [Q−μ+a]⁺，
 *   ½ΣQ⁺² − ½ΣQ² ≤ ½Σ(μ²+a²) − ΣQ(μ−a)
 * 是与到达分布无关的**路径必然**代数不等式；残差 = Σa_iμ_i + ½Σ[触底]D_i² ≥ 0。
 */
declare function driftCertificate(queues: readonly number[], nextQueues: readonly number[], mu: readonly number[], arrivals: readonly number[]): {
  bound: number;
  realized: number;
  residual: number;
};
