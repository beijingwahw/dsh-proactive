    quality?: number;
  }): Promise<'champion' | 'challenger' | 'none'>;
  /** A/B 分支报告（活跃分支双侧统计 + 已终结分支档案） */
  abReport(): ABBranchReport;
  /** 确定性路由决策（亏损补齐：落后于目标比例的一侧接收下一条流量） */
  private abRouteDecision;
  /** 分支裁决：双侧样本达标 → 按实际表现晋升/淘汰；达样本上限 → challenger 必须自证 */
