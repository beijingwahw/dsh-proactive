interface BenchmarkComparisonMatrix {
  models: string[];
  scenarios: string[];
  /** 行 = 模型 × 列 = 场景（与 models/scenarios 序一致） */
  grid: BenchmarkMatrixCell[][];
  /** 全部格子平铺（JSON 导出面） */
  cells: BenchmarkMatrixCell[];
  alpha: number;
  /** 每模型「场景最优」次数（全模型在案，0 次保留） */
  winsByModel: ReadonlyArray<{
    modelId: string;
    wins: number;
