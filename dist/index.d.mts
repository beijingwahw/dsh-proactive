type ClusterMethod = (typeof CLUSTER_METHOD)[keyof typeof CLUSTER_METHOD];
/** 点间度量（缺省欧氏；纯函数注入） */
type MetricFn = (a: ReadonlyArray<number>, b: ReadonlyArray<number>) => number;
interface MapperNode {
  /** 所属区间下标 k ∈ [0, intervals) */
