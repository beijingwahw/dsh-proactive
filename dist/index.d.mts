  /** 名次（按 shapley 降序，1 起） */
  rank: number;
  /** 是否精确枚举（false = 排列采样估计） */
  exact: boolean;
  /** 排列样本量（精确模式 = 联盟枚举覆盖数） */
  samples: number;
  /** Banzhaf 关键性：摇摆联盟占比（0~1；高 = 不可替代节点） */
  criticality: number;
  /** 虚拟玩家标记（所有边际 ≤ 容差——数学上应得 0） */
  isDummy: boolean;
