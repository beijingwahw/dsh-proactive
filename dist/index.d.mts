 * 只有真正孤立于**自己邻域**的点 LOF ≫ 1。
 *
 * 数值纪律: 邻居平局按下标序（确定序）; 近重复（全零 reach）时 lrd 以
 * 1e-12 均值截断（上限 1e12——诚实截断而非 Infinity 污染比值）。
 */
declare function localOutlierFactor(reference: readonly (readonly number[])[], x: readonly number[], options?: LofOptions): LofResult;
/** LOF 判别力总评（noveltyAUC 的 LOF 版: 平手计 0.5） */
declare function lofAUC(reference: readonly (readonly number[])[], inliers: readonly (readonly number[])[], outliers: readonly (readonly number[])[], options?: LofOptions): {
  auc: number;
  inlierMaxLof: number;
  outlierMinLof: number;
};
