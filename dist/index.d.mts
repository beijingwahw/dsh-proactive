/**
 * 标准正态分位数函数 Z(p) = Φ⁻¹(p)（Acklam 有理近似 + 一次 Halley 打磨，
 * |ε| ≲ 1e-9）。p 须落在开区间 (0,1)。
 */
declare function probit(p: number): number;
/** 一阶信号检测论读出（对数线性稳定化口径） */
interface TypeOneResult {
