    price?: number;
    depositRate?: number;
    fullQualityAt?: number;
  }): {
    ok: boolean;
    error?: string;
    contractId?: string;
  } | undefined;
  /**
   * 批量三路结算（宿主一拍多合约）：quality ≥ fullQualityAt 全额 /
