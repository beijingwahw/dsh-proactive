 */
declare class GoalEngine {
  private config;
  private goals;
  private goalCounter;
  private subtaskCounter;
  /** 第四轮升级：共享资源池容量（attachResourcePool 挂载；未挂载 → 冲突检测恒空，零漂移） */
  private resourcePool?;
  constructor(config?: Partial<GoalEngineConfig>);
  /**
   * 从洞察批量生成目标（自主目标生成的核心入口）
