  /** 最大迭代（缺省 60；提前停止条件 = 最大质心位移 < 1e-12） */
  iters?: number;
  /** 随机源种子（缺省 14；与 rng 二选一，rng 优先） */
  seed?: number;
  /** 随机源（测试注入；缺省 mulberry32(seed)——确定性） */
  rng?: () => number;
}
