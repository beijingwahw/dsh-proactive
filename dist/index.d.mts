  readonly ToolResultEvents: number;
  /** tools/pre-execute 治理门（waterfall 模式） */
  readonly PreExecuteGate: number;
  /** 进度流式推送（宿主侧长连接） */
  readonly ProgressStreaming: number;
  /** 进度轮询（流式不可用时的降级替代） */
  readonly ProgressPolling: number;
  /** 结构化工具 schema（参数校验前置） */
