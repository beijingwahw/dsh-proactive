  attachRetryBandit(options?: {
    epsilon0?: number;
    epsilonMin?: number;
    decay?: number;
    seed?: number;
  }): void;
  /** A6 升级 3：重试 bandit 状态（未挂载零介入） */
  private retryBandit?;
  /** A6 升级 3：当前探索率 ε = max(εmin, ε0·decay^n)（n = 总拉动数） */
  private retryBanditEpsilon;
  /** A6 升级 3：贪心最优臂（平均失败成本更低者；两臂均无数据或平局时 retry-same——与固定规则缺省一致） */
