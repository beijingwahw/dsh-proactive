  targetNormalizedEntropy: number;
  /** 反馈增益 κ > 0（每步温度乘子的指数尺度；过大振荡、过小迟缓） */
  adjustmentRate: number;
  /** 温度下限 T_min > 0（数值护栏 + 防完全冻结） */
  minTemperature: number;
