  /** 各信号权重（缺省 failure 0.4 / anomaly 0.3 / unauthorized 0.3；和会被归一化） */
  weights?: Partial<Record<ThreatSignalKind, number>>;
  /** 分数阈值：≥ throttle → 直达 throttle；≥ breaker → 直达 breaker；≥ kill → 直达 kill */
  thresholds?: {
    throttle?: number;
    breaker?: number;
