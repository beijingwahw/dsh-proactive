/** 缺省优先级函数：线性加权（文档化；可被 makeLinearPriority / 任意注入替换） */
declare function defaultPriority(b: BidInput): number;
/** 线性优先级工厂（权重可注入；要求非负且和为 1，显式 throw） */
declare function makeLinearPriority(weights: PriorityWeights): (b: BidInput) => number;
/** 内核缺省配置 */
interface GlobalWorkspaceDefaults {
  /** 点火阈值 θ ∈ [0,1]（缺省 0.5：半数自信以下的发现不上总线） */
  threshold: number;
  /** WTA 温度 T ≥ 0（缺省 0 = 硬胜者串行注意力） */
  temperature: number;
  /** 不应期步数 ω ≥ 0（缺省 0 = 关闭；整数） */
  refractory: number;
  /** 不应期折扣底数 δ ∈ (0,1)（缺省 0.5） */
  refractoryFactor: number;
