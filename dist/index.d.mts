  /** 已违规终态的监视器数 */
  violatedMonitors: number;
  /** 累计违规报告数 */
  totalViolations: number;
  /** 按严重级分组的违规计数 */
  bySeverity: Record<ViolationSeverity, number>;
  /** 已观察事件总数 */
  eventsObserved: number;
  /** 在途义务数（response-deadline 未决） */
  pendingObligations: number;
  /** 各规约的最近违规（id → 报告） */
