/** 投标分解（各分量 ∈ [0,1]，越界饱和裁剪；非有限数显式 throw） */
interface BidInput {
  /** 新奇度：内容偏离背景预期的程度 */
  novelty: number;
  /** 关联度：与当前目标 / 广播上下文的相关性（级联的载体） */
  relevance: number;
  /** 自信度：模块对自己发现的确定性 */
  confidence: number;
  /** 紧急性：延误代价 */
  urgency: number;
}
/** 步进时喂给 priorityFn 的外部上下文（世界信号 + 当前目标） */
interface WorkspaceContext {
