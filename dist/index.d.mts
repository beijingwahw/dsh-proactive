      argumentation?: {
        enabled?: boolean;
      };
      /** 82.0 众包聚合：多模型判定的 Dawid–Skene 信任票权（对角塌陷 = 自动摘牌；咨询口径） */
      crowdAggregation?: {
        enabled?: boolean;
      };
      /** 83.0 世界模型学习：调度轨迹学 T̂/r̂ + 值迭代 + Bellman 残差健康度（旁路咨询） */
      worldModelLearning?: {
        enabled?: boolean;
        prior?: number;
      };
