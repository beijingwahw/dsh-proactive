   * @param arm 本次实际执行的臂
   * @param failureCost 本次失败成本（token / 时延折算，正数；成本越低越好）
   */
  retryBanditSettle(arm: RetryBanditArm, failureCost: number): void;
  /** A6 升级 3：bandit 状态总览（未挂载 undefined） */
  retryBanditStatus(): RetryBanditStatus | undefined;
  /**
