  budget: number;
  winner: T;
  winnerScore: number;
}
/** hyperband 主循环结果 */
interface HyperbandResult<T> {
  /** 历代观察分数最大的配置（论文口径 "largest L seen so far"; 平手取最早） */
  bestConfig: T;
  bestScore: number;
  /** 逐配置预算加和（=== schedule.totalBudget，1e-9 内） */
