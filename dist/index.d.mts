    count: number;
    cap: number;
    subscore: number;
    weight: number;
  }>;
  windowMs: number;
  /** 窗口内信号总数 */
  signalsInWindow: number;
  /** 分数对应的直达阶梯档位（低于 throttle 阈值 → null：走经典渐进） */
