   */
  settleDeliveries(results: Array<{
    contractId: string;
    quality?: number;
  }>): DeliverySettlementSummary | undefined;
  /** 合约台账视图（未挂载 undefined） */
  deliveryContracts(): DeliveryContractView[] | undefined;
