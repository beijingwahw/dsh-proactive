declare const DEFAULT_GLOBAL_WORKSPACE: GlobalWorkspaceDefaults;
/** 构造参数（modules 必填，其余可覆盖缺省） */
interface GlobalWorkspaceOptions {
  modules: WorkspaceModule[];
