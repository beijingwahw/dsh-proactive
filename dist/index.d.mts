  /** 形状 k（k<1 早期失效、k=1 偶发失效、k>1 耗损耗效） */
  readonly shape: number;
}
/**
 * Weibull 对数域生存函数: ln S(t) = −(t/λ)^k = −exp(k·(ln t − ln λ))
 *
 * 全程 log 域：k·(ln t − ln λ) > 709 时诚实地给出 −Infinity（S 下溢为 0），
