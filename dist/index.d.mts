  calibrate(p: number): number;
  /** 流式登记本期预报并返回校准值（之后必须 observe 回填结果） */
  calibrateNext(p: number): number;
  /** 结果回填：∂NLL/∂a = (p̂−y)·z，∂NLL/∂b = (p̂−y) */
  observe(y: number): void;
  get a(): number;
  get b(): number;
  stats(): PlattStats;
}
/** 工厂：在线 Platt 校准器 */
declare function onlinePlatt(options?: OnlinePlattOptions): OnlinePlatt;
interface WindowedIsotonicOptions {
  /** 滑动窗口容量（缺省 300） */
  window?: number;
  /** 窗内少于此样本数时恒等直通（诚实：证据不足不动刀；缺省 30） */
