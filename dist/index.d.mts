  topologicalOrder(): readonly string[];
  /** 全部环（每环为类型名序列 a → b → … → a；DFS 判定，确定性；无环返回空） */
  detectCycles(): readonly string[][];
  /** 图结构快照（节点 + 边；dashboard 消费形态；全部按注册序确定） */
  describe(): {
    registry: string;
    nodes: readonly TypeMeta[];
    edges: ReadonlyArray<{
      from: string;
      to: string;
      registered: boolean;
    }>;
  };
  /** 确定性 DOT 导出（graphviz 直接渲染；节点/边均按注册序） */
  toDot(): string;
  private require;
}
