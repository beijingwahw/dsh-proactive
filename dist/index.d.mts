  deployAtomic(options?: AtomicSwapOptions): Promise<AtomicSwapResult>;
  /** 防抖调度重载流程 */
  private scheduleReload;
  /**
   * 环检测：新增边 (moduleId → dep) 成环 ⟺ dep 经既有依赖边传递依赖 moduleId。
