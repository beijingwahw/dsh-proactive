  private wouldCycle;
  /** 依赖闭包：种子 ∪ 全部传递依赖者（反向边 BFS） */
  private dependencyClosure;
  /**
   * Kahn 拓扑排序（闭包内入度归零出队；注册序为平局裁决——确定性）。
   * 依赖先于依赖者；有环时返回已排序前缀 + acyclic=false + 环成员
