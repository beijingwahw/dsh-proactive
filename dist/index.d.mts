interface DomainGapOptions {
  /** 真实分布均值位移 μ（缺省 1；仿真恒为 N(0,1)） */
  shift?: number;
  /** 真实分布尺度 σ（缺省 1；real ~ N(μ, σ²)） */
  scale?: number;
  /** 仿真样本流种子（缺省 1；真实流用 seed + 1_000_003 独立同构） */
  seed?: number;
  /** 仿真样本数（缺省 2000） */
  nSim?: number;
  /** 真实样本数（缺省 2000） */
  nReal?: number;
}
/** 已知解析域差: 闭式密度比对照的工厂产物 */
interface DomainGap {
  readonly shift: number;
  readonly scale: number;
  readonly sim: number[];
  readonly real: number[];
