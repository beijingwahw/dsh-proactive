  /** 活跃元素（add 过且未 tomb） */
  elements(): string[];
  /** 合并 = 两集分别并（交换/结合/幂等三律的逐位检查锚点） */
  merge(other: TwoPhaseSet): void;
  /** 状态快照（可序列化口径） */
  state(): {
    added: string[];
    tombed: string[];
  };
  clone(): TwoPhaseSet;
}
