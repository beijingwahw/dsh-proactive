  /** 多模态内容（图文混排载荷） */
  readonly MultimodalContent: number;
};
type HostFeatureName = keyof typeof HostFeature;
/** 版本化能力集（协议版本 + 特性位向量） */
interface HostCapabilities {
  protocolVersion: number;
