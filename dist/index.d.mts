 */
declare function classifyTaxonomy(error: unknown): ErrorTaxonomyEntry;
/** 错误 → 建议 HTTP 状态码（映射助手） */
declare function errorToHttpStatus(error: unknown): number;
/** 错误 → Tool 层结构化返回值（ok:false 判别形态，internalDetail 默认不透出） */
declare function errorToToolReturn(error: unknown): {
