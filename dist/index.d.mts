/** 加权 Shapley 报告（R5-A13：Kalai–Samet 非对称权） */
interface WeightedShapleyReport {
  players: number;
  totalValue: number;
  /** 非对称权重（与入参对齐；全部等权时精确退化为经典 Shapley） */
