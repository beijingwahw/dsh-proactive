  code: string;
  message: string;
  severity: ErrorSeverity;
  retryability: ErrorRetryability;
  userMessage: string;
  internalDetail: string;
  httpStatus: number;
  toolVisible: boolean;
  details?: Record<string, unknown>;
  /** 因果链下一环（wrapError 产生） */
