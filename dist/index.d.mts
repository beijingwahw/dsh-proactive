  readonly actions: number[];
  readonly horizon: number;
  /** 每视界层裁剪后 |Γ_t|（增长审计） */
  readonly sizes: number[];
  /** V_H(b) = max_α α·b（信念只读闭包） */
  readonly valueAt: (b: number[]) => number;
  /** R5：本次运行的支配检验统计（等价性证据 + 预过滤跳过率审计） */
  readonly pruneStats: PruneStats;
}
