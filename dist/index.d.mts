  evidence?: MemoryEvidence;
  generation: number;
  createdAt: number;
  /** 第三轮升级：父代基因组 id（谱系追踪；种子/重启注入个体无父代） */
  parentId?: string;
  /** 第三轮升级：出生所经变异算子（seed / gaussian / large-step / boundary / baseline-reset / natural-gradient / restart-diversify） */
