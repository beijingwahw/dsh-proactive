  temperature?: number;
  refractory?: number;
  refractoryFactor?: number;
  priorityFn?: (b: BidInput) => number;
  seed?: number;
  /**
   * R5·A1 注意力温度自适应退火（opt-in；缺省 undefined = 恒温零漂移）。
   * 配置后温度按广播熵反馈每步调节（见头注 R5 段），currentTemperature() 可观测。
   */
